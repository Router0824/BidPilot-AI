# BidPilot-AI ModelScope release environment template.
# Do not put real API keys in this file.

BIDPILOT_APP_NAME=BidPilot-AI
BIDPILOT_DEBUG=false
BIDPILOT_SECRET_KEY=change-this-in-platform-secret-settings
BIDPILOT_DATABASE_URL=sqlite+aiosqlite:///./data/bidpilot.db
BIDPILOT_UPLOAD_DIR=./data/uploads
BIDPILOT_MAX_UPLOAD_SIZE_MB=200
BIDPILOT_CORS_ORIGINS=["*"]

# Public community demo: use mock by default.
BIDPILOT_LLM_PROVIDER=mock
BIDPILOT_LLM_API_KEY=
BIDPILOT_LLM_BASE_URL=
BIDPILOT_LLM_MODEL=
BIDPILOT_LLM_FAST_MODEL=
BIDPILOT_LLM_QUALITY_MODEL=
BIDPILOT_LLM_TIMEOUT_SECONDS=60
BIDPILOT_LLM_COST_LIMIT_PER_PROJECT=0
BIDPILOT_LLM_ESTIMATED_COST_PER_1K_TOKENS=0

# Runtime port used by ModelScope Spaces or Docker-based platforms.
PORT=7860

