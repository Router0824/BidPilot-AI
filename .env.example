# BidPilot-AI local development defaults
BIDPILOT_APP_NAME=BidPilot-AI
BIDPILOT_DEBUG=true
BIDPILOT_DATABASE_URL=sqlite+aiosqlite:///./bidpilot.db
BIDPILOT_UPLOAD_DIR=./uploads
BIDPILOT_MAX_UPLOAD_SIZE_MB=200

# Local demo mode. mock never calls an external model and works without API keys.
BIDPILOT_LLM_PROVIDER=mock
BIDPILOT_LLM_API_KEY=
BIDPILOT_LLM_BASE_URL=https://api.deepseek.com
BIDPILOT_LLM_MODEL=deepseek-v4-flash
BIDPILOT_LLM_FAST_MODEL=deepseek-v4-flash
BIDPILOT_LLM_QUALITY_MODEL=deepseek-v4-pro
BIDPILOT_LLM_TIMEOUT_SECONDS=60
BIDPILOT_LLM_COST_LIMIT_PER_PROJECT=0
BIDPILOT_LLM_ESTIMATED_COST_PER_1K_TOKENS=0

# Frontend dev proxy expects backend on http://localhost:8000
BIDPILOT_BACKEND_PORT=8000
BIDPILOT_FRONTEND_PORT=5173

# Demo accounts are hard-coded for local Mock demonstration only.
# Do not use these credentials or the default secret key in production.
