# BidPilot / BidMaster Pro local development
BIDPILOT_DEBUG=true
BIDPILOT_DATABASE_URL=sqlite+aiosqlite:///./bidpilot.db
BIDPILOT_UPLOAD_DIR=./uploads

# mock: 不调用真实模型；deepseek/openai: 使用 OpenAI-compatible Chat Completions
BIDPILOT_LLM_PROVIDER=mock
BIDPILOT_LLM_API_KEY=
BIDPILOT_LLM_BASE_URL=https://api.deepseek.com
BIDPILOT_LLM_MODEL=deepseek-v4-flash
BIDPILOT_LLM_FAST_MODEL=deepseek-v4-flash
BIDPILOT_LLM_QUALITY_MODEL=deepseek-v4-pro
BIDPILOT_LLM_TIMEOUT_SECONDS=60

# Frontend dev proxy expects backend on http://localhost:8000
